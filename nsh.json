{
  "name": "Maka Tutor NSH",
  "id": "com.eijunnn.makatutornsh",
  "version": "0.2.0",
  "build": 3,
  "appearance": "dark",
  "updater": {
    "github": "EijunnN/maka-tutor-nsh",
    "publicKey": "uPGnT1tO4ibp+oTri/lCbKrt97fM3un252o1NCBHYkM="
  },
  "rust": ".",
  "window": {
    "title": "Maka Tutor",
    "defaultSize": { "width": 420, "height": 620 },
    "maximizable": false,
    "closeOnPress": false,
    "defaultVisible": false,
    "frame": "none",
    "backdrop": "hud",
    "shadow": true
  },
  "capabilities": {
    "windows": { "kinds": ["normal", "popup", "overlay"], "overlay": true },
    "process": {
      "execute": ["claude"],
      "env": ["APPDATA", "LOCALAPPDATA", "USERNAME", "ANTHROPIC_API_KEY", "ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CONFIG_DIR"]
    },
    "fs": { "read": ["${dataDir}"], "write": ["${dataDir}"] },
    "clipboard": true,
    "picker": true,
    "statusBar": true
  }
}
